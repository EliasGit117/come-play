generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NewsStatus {
  published
  hidden
}

model News {
  id        Int        @id @default(autoincrement())
  titleRo   String     @map("title_ro")
  titleRu   String     @map("title_ru")
  slug      String     @unique
  contentRo String?    @map("content_ro")
  contentRu String?    @map("content_ru")
  status    NewsStatus @default(hidden)
  image     NewsImage?

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  Subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId Int?

  @@index(fields: [titleRo, titleRu, slug, status])
  @@map("news")
}

model NewsImage {
  id           Int     @id @default(autoincrement())
  url          String
  thumbhash    Bytes?
  type         String
  size         Int
  originalName String? @map("original_name")
  width        Int?
  height       Int?

  newsId Int  @unique
  news   News @relation(fields: [newsId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([newsId])
  @@map("news_images")
}

model Banner {
  id       Int     @id @default(autoincrement())
  title    String  @map("title")
  titleRo  String? @map("title_ro")
  titleRu  String? @map("title_ru")
  textRo   String? @map("text_ro")
  textRu   String? @map("text_ru")
  path     String?
  order    Int
  isActive Boolean @default(true) @map("is_active")

  desktopImage BannerImage? @relation("DesktopImage")
  tabletImage  BannerImage? @relation("TabletImage")
  mobileImage  BannerImage? @relation("MobileImage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, order])
  @@map("banners")
}

enum BannerImageType {
  desktop
  tablet
  mobile
}

model BannerImage {
  id           Int             @id @default(autoincrement())
  url          String
  thumbhash    Bytes?
  type         String
  size         Int
  originalName String?         @map("original_name")
  width        Int?
  height       Int?
  imageType    BannerImageType @map("image_type")

  desktopBannerId Int? @unique @map("desktop_banner_id")
  tabletBannerId  Int? @unique @map("tablet_banner_id")
  mobileBannerId  Int? @unique @map("mobile_banner_id")

  bannerDesktop Banner? @relation("DesktopImage", fields: [desktopBannerId], references: [id])
  bannerTablet  Banner? @relation("TabletImage", fields: [tabletBannerId], references: [id])
  bannerMobile  Banner? @relation("MobileImage", fields: [mobileBannerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([desktopBannerId, tabletBannerId, mobileBannerId])
  @@map("banner_images")
}

model Category {
  id            Int     @id @default(autoincrement())
  nameRo        String  @map("name_ro")
  nameRu        String  @map("name_ru")
  slug          String  @unique
  descriptionRo String? @map("description_ro")
  descriptionRu String? @map("description_ru")

  subcategories Subcategory[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("categories")
}

model Subcategory {
  id            Int     @id @default(autoincrement())
  nameRo        String  @map("name_ro")
  nameRu        String  @map("name_ru")
  slug          String
  descriptionRo String? @map("description_ro")
  descriptionRu String? @map("description_ru")

  categoryId Int? // Make optional
  category   Category? @relation(fields: [categoryId], references: [id])

  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  News      News[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

enum ProductState {
  available
  not_available
  out_of_stock
}

enum ProductSticker {
  new
  sale
}

model Product {
  id     Int    @id @default(autoincrement())
  nameRo String @map("name_ro")
  nameRu String @map("name_ru")
  slug   String @unique

  state         ProductState @default(available)
  hidden        Boolean      @default(false)
  richContentRo String?      @map("rich_content_ro")
  richContentRu String?      @map("rich_content_ru")

  price    Decimal  @map("price")
  oldPrice Decimal? @map("old_price")

  sticker ProductSticker? @map("sticker")

  shortDescriptionRo String? @map("short_description_ro")
  shortDescriptionRu String? @map("short_description_ru")

  images ProductImage[]

  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([subcategoryId])
  @@map("products")
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  url          String
  thumbhash    Bytes?
  type         String
  size         Int
  originalName String? @map("original_name")
  width        Int?
  height       Int?
  order        Int

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([productId, order])
  @@map("product_images")
}
